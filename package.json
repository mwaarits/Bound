{
  "name": "bound",
  "version": "0.0.0",
  "private": true,
  "description": "Bound — programmable donations spendable only at whitelisted stores. Hackathon testnet MVP.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:contracts": "pnpm --filter bound-contracts build",
    "build:relayer": "pnpm --filter bound-relayer build",
    "build:web": "pnpm --filter bound-web build",
    "dev:relayer": "pnpm --filter bound-relayer dev",
    "dev:web": "pnpm --filter bound-web dev",
    "test:contracts": "pnpm --filter bound-contracts test",
    "test:relayer": "pnpm --filter bound-relayer test",
    "test:web": "pnpm --filter bound-web test"
  }
}
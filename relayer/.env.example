# Relayer ENV — copy to .env and fill in real values
# Chain
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Contract addresses (filled after T2.1 deploy; see docs/deployments.md)
MOCKIDRX_ADDRESS=
CAMPAIGN_FACTORY_ADDRESS=
CAMPAIGN_ADDRESS=

# Relayer EOA (the agent — funds gas tank; pays belanja() gas per BR-10)
RELAYER_PRIVATE_KEY=

# Master key for custodial wallet encryption (AES-256-GCM; ENV per Decision 4)
MASTER_KEY=

# JWT
JWT_SECRET=
JWT_TTL_SECONDS=900

# OTP
OTP_MODE=mock

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

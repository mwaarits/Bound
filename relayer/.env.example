# Relayer ENV — copy to .env, fill values
# Contract addresses filled after T2.1 deploy; see docs/deployments.md

# Chain
RPC_URL=https://sepolia.base.org
CHAIN_ID=8453

# Contract addresses (Base Sepolia)
MOCKIDRX_ADDRESS=
CAMPAIGN_FACTORY_ADDRESS=
CAMPAIGN_ADDRESS=

# Relayer EOA (the agent — funds gas tank; pays belanja() gas per BR-10)
RELAYER_PRIVATE_KEY=

# Custodial wallet master key (AES-256-GCM; ENV per Decision 4 — SPOF disclosed honestly)
MASTER_KEY=

# JWT
JWT_SECRET=
JWT_TTL_SECONDS=900

# OTP
OTP_MODE=mock

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info